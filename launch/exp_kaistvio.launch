<launch>


    <!-- dataset name -->
    <!-- circle, circle_fast, circle_head -->
    <!-- infinite, infinite_fast, infinite_head -->
    <!-- rotation, rotation_fast -->
    <!-- square, square_fast -->
    <arg name="dataset" value="circle" />
    <arg name="folder"  value="/media/patrick/RPNG FLASH 3/KAIST_VIO/" />


    <!-- MASTER NODE! -->
    <node name="estimate_vicon2gt" pkg="vicon2gt" type="estimate_vicon2gt" output="screen" clear_params="true" required="true">
<!--    <node name="estimate_vicon2gt" pkg="vicon2gt" type="estimate_vicon2gt" output="screen" clear_params="true" required="true" launch-prefix="gdb -ex run &#45;&#45;args">-->

        <!-- bag topics -->
        <param name="topic_imu"      type="string" value="/mavros/imu/data" />
        <param name="topic_cam"      type="string" value="/camera/infra1/image_rect_raw" />
        <param name="topic_vicon"    type="string" value="/pose_transformed" />

        <!-- bag parameters -->
        <param name="path_bag"    type="string" value="$(arg folder)/$(arg dataset).bag" />
        <param name="bag_start"   type="int"    value="0" />
        <param name="bag_durr"    type="int"    value="-1" />

        <!-- save information -->
        <param name="save2file"          type="bool"   value="true" />
        <param name="stats_path_states"  type="string" value="$(arg folder)/vicon2gt/traj/$(arg dataset).csv" />
        <param name="stats_path_info"    type="string" value="$(arg folder)/vicon2gt/info/$(arg dataset).txt" />

        <!-- world parameters -->
        <rosparam param="R_BtoI">[1, 0, 0, 0, 1, 0, 0, 0, 1]</rosparam>
        <rosparam param="p_BinI">[0.122879284817, 0.0510517726067, 0.0]</rosparam>
        <rosparam param="R_GtoV">[1, 0, 0, 0, 1, 0, 0, 0, 1]</rosparam>
        <param name="gravity_magnitude"          type="double" value="9.81" />
        <param name="toff_imu_to_vicon"          type="double" value="0.0" />
        <param name="num_loop_relin"             type="int"    value="0" />
        <param name="estimate_toff_vicon_to_imu" type="bool"   value="true" />
        <param name="estimate_ori_vicon_to_imu"  type="bool"   value="true" />
        <param name="estimate_pos_vicon_to_imu"  type="bool"   value="true" />

        <!-- vicon sigmas, only used if we don't get odometry -->
        <!-- sigmas: (rx,ry,rz,px,py,pz) -->
        <rosparam param="vicon_sigmas">[1e-3,1e-3,1e-3,1e-2,1e-2,1e-2]</rosparam>
        <param name="freq_pub_raw_vicon" type="double" value="10.0" />
        <param name="use_manual_sigmas"  type="bool"   value="true" />

        <!-- vi-sensor -->
        <param name="gyroscope_noise_density"      type="double"   value="0.002" />
        <param name="gyroscope_random_walk"        type="double"   value="0.0001" />
        <param name="accelerometer_noise_density"  type="double"   value="0.02" />
        <param name="accelerometer_random_walk"    type="double"   value="0.001" />


    </node>


</launch>